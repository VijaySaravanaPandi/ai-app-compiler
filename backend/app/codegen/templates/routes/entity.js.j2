const express = require('express');
const { getDb } = require('../db');
const { authenticate, authorize } = require('../middleware/auth');

const router = express.Router();
const TABLE = '{{ entity_name | lower }}s';

// GET /api/{{ entity_name | lower }}s — list all (authenticated)
router.get('/', authenticate, (req, res) => {
  const db = getDb();
  const rows = db.prepare(`SELECT * FROM ${TABLE} LIMIT 500`).all();
  res.json(rows);
});

// GET /api/{{ entity_name | lower }}s/:id — get one
router.get('/:id', authenticate, (req, res) => {
  const db = getDb();
  const row = db.prepare(`SELECT * FROM ${TABLE} WHERE id = ?`).get(req.params.id);
  if (!row) return res.status(404).json({ error: 'Not found' });
  res.json(row);
});

// POST /api/{{ entity_name | lower }}s — create
router.post('/', authenticate, (req, res) => {
  const db = getDb();
  const fields = {{ columns | tojson }};
  const values = fields.map(f => req.body[f] ?? null);
  const placeholders = fields.map(() => '?').join(', ');
  const result = db
    .prepare(`INSERT INTO ${TABLE} (${fields.join(', ')}) VALUES (${placeholders})`)
    .run(...values);
  res.status(201).json({ id: result.lastInsertRowid });
});

// PUT /api/{{ entity_name | lower }}s/:id — update
router.put('/:id', authenticate, (req, res) => {
  const db = getDb();
  const fields = {{ columns | tojson }};
  const setClauses = fields.map(f => `${f} = ?`).join(', ');
  const values = fields.map(f => req.body[f] ?? null);
  db.prepare(`UPDATE ${TABLE} SET ${setClauses} WHERE id = ?`).run(...values, req.params.id);
  res.json({ updated: true });
});

// DELETE /api/{{ entity_name | lower }}s/:id — delete (admin only)
router.delete('/:id', authenticate, authorize('admin'), (req, res) => {
  const db = getDb();
  db.prepare(`DELETE FROM ${TABLE} WHERE id = ?`).run(req.params.id);
  res.json({ deleted: true });
});

module.exports = router;
